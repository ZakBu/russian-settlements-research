{
  "schema": "repository_policy.v2",
  "purpose": "Keep Git for code and texts; data, maps and documents go to GitHub Releases.",
  "max_file_bytes": 1048576,
  "max_tree_bytes": 134217728,
  "file_size_overrides": {
    "data/catalog.json": 16777216,
    "data/catalog-20261022-recovery-v1.json": 16777216
  },
  "forbidden_extensions": [
    ".parquet", ".zip", ".gz", ".bz2", ".xz", ".7z", ".tar", ".pdf", ".png", ".jpg", ".jpeg",
    ".gif", ".tif", ".tiff", ".svg", ".geojson", ".gpkg", ".shp", ".xls", ".xlsx", ".docx",
    ".pbf", ".duckdb", ".sqlite", ".pkl", ".npy"
  ],
  "allowed_exceptions": [
    "research_context/primary/word_concept.docx"
  ],
  "required_paths": [
    "README.md", "AGENTS.md", "LICENSE", "POPULATION_BASE.md", "decisions.json",
    "research_context/current_state.json", "research_context/primary/word_concept.docx",
    "research_context/primary/word_concept_extracted.txt",
    "research_context/population_source_manifest.json", "data/catalog.json"
  ]
}
