{
  "schema": "sgrt.repository_policy.v1",
  "purpose": "Code, one current overview, decisions and source metadata; no generated reports or datasets.",
  "max_file_bytes": 1048576,
  "max_snapshot_bytes": 104857600,
  "target_full_repository_bytes": 4294967296,
  "size_scope_note": "Current-tree checks cannot prove remote Git history or GitHub GC size.",
  "exact_paths": [
    "README.md",
    ".gitignore",
    "decisions.json",
    "repository_policy.json",
    "repository_inventory.json"
  ],
  "instruction_or_license_names": [
    "AGENTS.md",
    "LICENSE",
    "LICENSE.md",
    "Dockerfile",
    "Makefile"
  ],
  "code_extensions": [
    ".py",
    ".pyi",
    ".sh",
    ".bash",
    ".js",
    ".mjs",
    ".cjs",
    ".ts",
    ".tsx",
    ".jsx",
    ".ipynb",
    ".sql",
    ".r",
    ".R",
    ".css",
    ".scss",
    ".j2",
    ".jinja",
    ".jinja2"
  ],
  "configuration_extensions": [
    ".yaml",
    ".yml",
    ".toml",
    ".ini",
    ".cfg"
  ]
}
