uest_deletion": "https://zenodo.org/api/records/7856627/request-deletion", "file_modification": "https://zenodo.org/api/records/7856627/file-modification", "quota_increase": "https://zenodo.org/api/records/7856627/quota-increase", "requests": "https://zenodo.org/api/records/7856627/requests"}, "updated": "2024-07-12T06:17:21.157248+00:00", "recid": "7856627", "revision": 5, "files": [{"id": "4faa8f0a-9006-4a4e-8d2a-d8bb664a4f22", "key": "5. QORIYEV.pdf", "size": 1699310, "checksum": "md5:8185196bf8412a3ed392a95d7c177193", "links": {"self": "https://zenodo.org/api/records/7856627/files/5.%20QORIYEV.pdf/content"}}], "swh": null, "owners": [{"id": "421426"}], "status": "published", "stats": {"downloads": 215, "unique_downloads": 192, "views": 276, "unique_views": 258, "version_downloads": 213, "version_unique_downloads": 190, "version_unique_views": 254, "version_views": 272}, "state": "done", "submitted": true}, {"created": "2025-04-22T12:37:04.206850+00:00", "modified": "2025-04-22T12:37:04.397895+00:00", "id": 15261731, "conceptrecid": "15261730", "doi": "10.5281/zenodo.15261731", "conceptdoi": "10.5281/zenodo.15261730", "doi_url": "https://doi.org/10.5281/zenodo.15261731", "metadata": {"title": "SABZAVOTLARNI SAQLASHDA OZON QURILMASIDAN FOYDALANISHNING ISTIQBOLLARI.", "doi": "10.5281/zenodo.15261731", "publication_date": "2025-04-22", "description": "<p><em><span lang=\"EN-US\">Ushbu maqolada sabzavotlarni saqlash jarayonida ozon uskunalaridan foydalanishning samaradorligi va istiqbollari tahlil qilinadi. Sabzavotlarni saqlash muddatini uzaytirish uchun mavjud bo&lsquo;lgan ko&lsquo;plab texnologiyalar orasida, ozon texnologiyasi yuqori samarali, ekologik, sterilizatsiya usuli sifatida o&lsquo;zini ko&lsquo;rsatadi. Ozonning bakteriyalar va zamburug&lsquo;larning rivojlanishini oldini olish, bartaraf etishdagi ro&lsquo;li hamda mahsulotlarning saqlash muddati va sifatiga ta&rsquo;siri ko&lsquo;rib chiqiladi. Shuningdek, ozon texnologiyalarining ekologik jihatdan xavfsizligi va iqtisodiy samaradorligi muhokama qilinadi.</span></em></p>", "access_right": "open", "creators": [{"name": "Mexmonov Botir Ilyos o'g'li, Xakimov Dilmurod Valijon o'g'li", "affiliation": null}], "resource_type": {"title": "Conference paper", "type": "publication", "subtype": "conferencepaper"}, "license": {"id": "cc-by-4.0"}, "relations": {"version": [{"index": 0, "is_last": true, "parent": {"pid_type": "recid", "pid_value": "15261730"}}]}}, "title": "SABZAVOTLARNI SAQLASHDA OZON QURILMASIDAN FOYDALANISHNING ISTIQBOLLARI.", "links": {"self": "https://zenodo.org/api/records/15261731", "self_html": "https://zenodo.org/records/15261731", "preview_html": "https://zenodo.org/records/15261731?preview=1", "doi": "https://doi.org/10.5281/zenodo.15261731", "self_doi": "https://doi.org/10.5281/zenodo.15261731", "self_doi_html": "https://zenodo.org/doi/10.5281/zenodo.15261731", "reserve_doi": "https://zenodo.org/api/records/15261731/draft/pids/doi", "parent": "https://zenodo.org/api/records/15261730", "parent_html": "https://zenodo.org/records/15261730", "parent_doi": "https://doi.org/10.5281/zenodo.15261730", "parent_doi_html": "https://zenodo.org/doi/10.5281/zenodo.15261730", "self_iiif_manifest": "https://zenodo.org/api/iiif/record:15261731/manifest", "self_iiif_sequence": "https://zenodo.org/api/iiif/record:15261731/sequence/default", "files": "https://zenodo.org/api/records/15261731/files", "media_files": "https://zenodo.org/api/records/15261731/media-files", "thumbnails": {"10": "https://zenodo.org/api/iiif/record:15261731:1.200.pdf/full/%5E10,/0/default.jpg", "50": "https://zenodo.org/api/iiif/record:15261731:1.200.pdf/full/%5E50,/0/default.jpg", "100": "https://zenodo.org/api/iiif/record:15261731:1.200.pdf/full/%5E100,/0/default.jpg", "250": "https://zenodo.org/api/iiif/record:15261731:1.200.pdf/full/%5E250,/0/default.jpg", "750": "https://zenodo.org/api/iiif/record:15261731:1.200.pdf/full/%5E750,/0/default.jpg", "1200": "https://zenodo.org/api/iiif/record: