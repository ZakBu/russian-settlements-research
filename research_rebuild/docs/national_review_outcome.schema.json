{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "National settlement review outcome",
  "description": "Independent review decisions for identity, population scope, point object, temporal coordinate applicability, and source-value selection. These axes are not inferred from one another.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "case_id",
    "input_manifest_sha256",
    "reviewer_id",
    "reviewed_at",
    "target_observation_ids",
    "identity_decision",
    "population_scope_decision",
    "point_object_decision",
    "coordinate_temporal_decision",
    "source_value_selection_decision"
  ],
  "properties": {
    "contract_version": { "const": "1.0" },
    "case_id": { "type": "string", "minLength": 1 },
    "input_manifest_sha256": { "$ref": "#/$defs/sha256" },
    "reviewer_id": { "type": "string", "minLength": 1 },
    "reviewed_at": { "type": "string", "format": "date-time" },
    "target_observation_ids": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "identity_decision": {
      "$ref": "#/$defs/decision",
      "description": "Physical-place relationship only; does not admit population values or coordinates.",
      "properties": {
        "decision": { "enum": ["same_place", "distinct_places", "parent_or_subordinate", "incorporation", "split_or_merge", "unresolved", "insufficient_evidence"] }
      }
    },
    "population_scope_decision": {
      "$ref": "#/$defs/decision",
      "description": "Grain and coverage of a published value; not a place identity decision.",
      "properties": {
        "decision": { "enum": ["physical_locality", "city_proper", "city_plus_subordinates", "municipal_or_district_aggregate", "subject_aggregate", "federal_district_aggregate", "federal_city_region_aggregate", "selected_coverage_aggregate", "conflicting_scope", "unknown", "unresolved", "insufficient_evidence"] }
      }
    },
    "point_object_decision": {
      "$ref": "#/$defs/decision",
      "description": "Identity/type of the mapped object; does not establish a census-year coordinate claim.",
      "properties": {
        "decision": { "enum": ["named_settlement", "administrative_unit", "federal_city_or_region_aggregate", "garden_partnership_or_other_feature", "provider_fallback_or_wrong_object", "no_candidate_point", "unresolved", "insufficient_evidence"] },
        "point_object_ids": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "original_coordinates": {
          "oneOf": [
            { "type": "null" },
            { "type": "object", "additionalProperties": false, "required": ["latitude", "longitude"], "properties": {
              "latitude": { "type": "number", "minimum": -90, "maximum": 90 },
              "longitude": { "type": "number", "minimum": -180, "maximum": 180 }
            } }
          ]
        }
      }
    },
    "coordinate_temporal_decision": {
      "$ref": "#/$defs/decision",
      "description": "Observed date and temporal applicability of a coordinate or geometry.",
      "properties": {
        "decision": { "enum": ["direct_observation_record_link", "direct_same_observation_date", "dated_interval", "inferred_continuity", "no_continuity_claim", "rejected", "unresolved", "insufficient_evidence"] },
        "observed_date_or_interval": { "type": ["string", "null"] },
        "applicable_census_years": { "type": "array", "uniqueItems": true, "items": { "type": "integer", "minimum": 1897, "maximum": 2100 } },
        "time_gap_and_basis": { "type": ["string", "null"] }
      }
    },
    "source_value_selection_decision": {
      "$ref": "#/$defs/decision",
      "description": "Versioned choice of an additive population observation; does not establish identity or point admission.",
      "properties": {
        "decision": { "enum": ["select_for_release", "retain_as_alternative", "aggregate_only", "reject_source_row", "unresolved", "insufficient_evidence"] },
        "selected_source_record_ids": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
        "selection_version": { "type": ["string", "null"] }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "evidenceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_id", "evidence_kind", "relation", "lineage_status", "independence_family", "locator"],
      "properties": {
        "evidence_id": { "type": "string", "minLength": 1 },
        "evidence_kind": { "enum": ["official_census_row", "official_code_or_registry", "historical_map_or_gazetteer", "map_feature", "wikidata_statement", "parsed_wiki", "geocoder_response", "other"] },
        "relation": { "enum": ["supports", "contradicts", "context_only", "candidate_only"] },
        "lineage_status": { "enum": ["direct_source", "transcribed", "derived_from_prior_linkage", "unknown"] },
        "independence_family": { "type": "string", "minLength": 1 },
        "source_record_id": { "type": ["string", "null"] },
        "source_url": { "type": ["string", "null"], "format": "uri" },
        "source_sha256": { "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
        "source_date": { "type": ["string", "null"] },
        "temporal_applicability": { "type": ["string", "null"] },
        "locator": { "type": "string", "minLength": 1 },
        "limitations": { "type": "string" }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "evidence_refs", "rationale", "limitations"],
      "properties": {
        "decision": { "type": "string" },
        "evidence_refs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/evidenceRef" } },
        "rationale": { "type": "string", "minLength": 1 },
        "limitations": { "type": "string" },
        "point_object_ids": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "original_coordinates": {},
        "observed_date_or_interval": {},
        "applicable_census_years": {},
        "time_gap_and_basis": {},
        "selected_source_record_ids": {},
        "selection_version": {},
        "historical_observation_availability": {
          "enum": ["observed", "not_in_selected_slice", "outside_census_universe", "unknown"]
        }
      }
    }
  }
}
