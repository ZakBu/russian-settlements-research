3\u0442 \u0441 [[1941 \u0433\u043e\u0434]]\u0430. \u041f\u0440\u0435\u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d \u0432 \u0441\u0435\u043b\u044c\u0441\u043a\u0438\u0439 \u043d\u0430\u0441\u0435\u043b\u0451\u043d\u043d\u044b\u0439 \u043f\u0443\u043d\u043a\u0442 \u0432 2021 \u0433\u043e\u0434\u0443.\n\n== \u0416 ==\n* [[\u0416\u0435\u043b\u043d\u0438\u043d\u043e (\u041d\u0438\u0436\u0435\u0433\u043e\u0440\u043e\u0434\u0441\u043a\u0430\u044f \u043e\u0431\u043b\u0430\u0441\u0442\u044c)|\u0416\u0435\u043b\u043d\u0438\u043d\u043e]]\u00a0\u2014 \u043f\u0433\u0442 \u0441 1942 \u0433\u043e\u0434\u0430. \u041f\u0440\u0435\u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d \u0432 \u0441\u0435\u043b\u044c\u0441\u043a\u0438\u0439 \u043d\u0430\u0441\u0435\u043b\u0451\u043d\u043d\u044b\u0439 \u043f\u0443\u043d\u043a\u0442 \u043a 2022 \u0433\u043e\u0434\u0443.\n\n== \u0417 ==\n* [[\u0417\u0430\u0432\u043e\u043b\u0436\u044c\u0435 (\u0433\u043e\u0440\u043e\u0434)|\u0417\u0430\u0432\u043e\u043b\u0436\u044c\u0435]]\u00a0\u2014 \u043f\u0433\u0442 \u0441 [[1950 \u0433\u043e\u0434]]\u0430. \u041f\u0440\u0435\u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d \u0432 \u0433\u043e\u0440\u043e\u0434 \u0432 [[1964 \u0433\u043e\u0434]]\u0443.\n\n== \u041a ==\n* [[\u041a\u0430\u0442\u0443\u043d\u043a\u0438]]\u00a0\u2014 \u043f\u0433\u0442 \u0441 1938 \u0433\u043e\u0434\u0430. \u041f\u0440\u0435\u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d \u0432 \u0441\u0435\u043b\u044c\u0441\u043a\u0438\u0439 \u043d\u0430\u0441\u0435\u043b\u0451\u043d\u043d\u044b\u0439 \u043f\u0443\u043d\u043a\u0442 \u0432 2013 \u0433\u043e\u0434\u0443<ref name=\"nn13\">{{Cite web |url=http://www.zsno.ru/ru/146/?nid=7021&a=entry.show |title=\u0418\u0437\u043c\u0435\u043d\u0435\u043d \u0441\u0442\u0430\u0442\u0443\u0441 \u0442\u0440\u0435\u0445 \u0440\u0430\u0431\u043e\u0447\u0438\u0445 \u043f\u043e\u0441\u0435\u043b\u043a\u043e\u0432 \u041d\u0438\u0436\u0435\u0433\u043e\u0440\u043e\u0434\u0441\u043a\u04