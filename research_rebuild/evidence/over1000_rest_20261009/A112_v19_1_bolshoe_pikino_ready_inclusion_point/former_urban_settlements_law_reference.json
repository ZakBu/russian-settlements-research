44e\u0441\u0442\u0438\u0446\u0438\u0438 \u0420\u0424|\u041c\u0438\u043d\u044e\u0441\u0442\u0430 \u0420\u0424]]|access-date=2011-10-16|url-status=dead}}</ref>.\n\n== \u0421 ==\n* [[\u0421\u0430\u0440\u043e\u0432]]\u0430\u00a0\u2014 \u043f\u0433\u0442 \u0441 [[1938 \u0433\u043e\u0434]]\u0430. \u041f\u0440\u0435\u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d \u0432 \u0433\u043e\u0440\u043e\u0434 \u041a\u0440\u0435\u043c\u043b\u0451\u0432 \u0432 [[1954 \u0433\u043e\u0434]]\u0443.\n* [[\u0421\u0438\u0442\u043d\u0438\u043a\u0438 (\u041d\u0438\u0436\u0435\u0433\u043e\u0440\u043e\u0434\u0441\u043a\u0430\u044f \u043e\u0431\u043b\u0430\u0441\u0442\u044c)|\u0421\u0438\u0442\u043d\u0438\u043a\u0438]]\u00a0\u2014 \u043f\u0433\u0442 \u0441 [[1946 \u0433\u043e\u0434]]\u0430. \u041f\u0440\u0435\u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d \u0432 \u0441\u0435\u043b\u044c\u0441\u043a\u0438\u0439 \u043d\u0430\u0441\u0435\u043b\u0451\u043d\u043d\u044b\u0439 \u043f\u0443\u043d\u043a\u0442 \u0432 [[2004 \u0433\u043e\u0434]]\u0443<ref name=\"nnov141\" />.\n\n== \u0422 ==\n* [[\u041f\u0435\u0440\u0432\u043e\u043c\u0430\u0439\u0441\u043a (\u041d\u0438\u0436\u0435\u0433\u043e\u0440\u043e\u0434\u0441\u043a\u0430\u044f \u043e\u0431\u043b\u0430\u0441\u0442\u044c)|\u0422\u0430\u0448\u0438\u043d\u043e]]\u00a0\u2014 \u043f\u0433\u0442 \u0441 [[1927 \u0433\u043e\u0434]]\u0430. \u041f\u0440\u0435\u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d \u0432 \u0433\u043e\u0440\u043e\u0434 \u041f\u0435\u0440\u0432\u043e\u043c\u0430\u0439\u0441\u043a \u0432 [[1951 \u0433\u043e\u0434]]\u0443.\n* [[\u0422\u0451\u0448\u0430 (\u041d\u0430\u0432\u0430\u0448\u0438\u043d\u0441\u043a\u0438\u0439 \u0440\u0430\u0439\u043e\u043d)|\u0422\u0451\u0448\u0430]]\u00a0\u2014 \u043f\u0433\u0442 \u0441 1946 \u0433\u043e\u0434\u0430. \u041f\u0440\u0435\u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d \u0432 \u0441\u0435\u043b\u044c\u0441\u043a\u0438\u0439 \u043d\u0430\u0441\u0435\u043b\u0451\u043d\u043d\u044b\u0439 \u043f\u0443\u043d\u043a\u0442 \u0432 2013 \u0433\u043e\u0434\u0443<ref name=\"nn13\" />.\n\n== \u0423 ==\n* [[\u0423\u0440\u0435\u043d\u044c]]\u00a0\u2014 \u043f\u0433\u0442 \u0441 [[1959 \u0433\u043e\u0434]]\u0430. \u041f\u0440\u0435\u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d \u0432 \u0433\u043e\u0440\u043e\u0434 \u0432 [[1973 \u0433\u043e\u0434]]\u0443.\n\n== \u0427 ==\n* [[\u0427\u0438\u0441\u0442\u043e\u0435 (\u041d\u0438\u0436\u0435\u0433\u043e\u0440\u043e\u0434\u0441\u043a\u0430\u044f \u043e\u0431\u043b\u0430\u0441\u0442\u044c)|\u0427\u0438\u0441\u0442\u043e\u0435]]\u00a0\u2014 \u043f\u0433\u0442 \u0441 1939 \u0433\u043e\u0434\u0430. \u041f\u0440\u0435\u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d \u0432 \u0441\u0435\u043b\u044c\u0441\u043a\u0438\u0439 \u043d\u0430\u0441\u0435\u043b\u0451\u043d\u043d\u044b\u0439 \u043f\u0443\u043d\u043a\u0442 \u0432 2013 \u0433\u043e\u0434\u0443<ref name=\"nn13\" />.\n* [[\u0427\u043a\u0430\u043b\u043e\u0432\u0441\u043a (\u041d\u0438\u0436\u0435\u0433\u043e\u0440\u043e\u0434\u0441\u043a\u0430\u044f \u043e\u0431\u043b\u0430\u0441\u0442\u044c)|\u0427\u043a\u0430\u043b\u043e\u0432\u0441\u043a]]\u00a0\u2014 \u043f\u0433\u0442 \u0441 [[1927 \u0433\u043e\u0434]]\u0430. \u0414\u043e [[1937 \u0433\u043e\u0434]]\u0430 \u043d\u0430\u0437\u044b\u0432\u0430\u043b\u0441\u044f '''\u0412\u0430\u0441\u0438\u043b\u0451\u0432\u043e'''. \u041f\u0440\u0435\u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d \u0432 \u0433\u043e\u0440\u043e\u0434 \u0432 [[1955 \u0433\u043e\u0434]]\u0443.\n\n== \u0428 ==\n* [[\u0428\u0430\u0445\u0443\u043d\u044c\u044f]]\u00a0\u2014 \u043f\u0433\u0442 \u0441 [[1933 \u0433\u043e\u0434]]\u0430. \u041f\u0440\u0435\u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d \u0432 \u0433\u043e\u0440\u043e\u0434 \u0432 [[1943 \u0433\u043e\u0434]]\u0443.\n\n== \u042e ==\n* [[\u042e\u0436\u043d\u044b\u0439 (\u041d\u0438\u0436\u0435\u0433\u043e\u0440\u043e\u0434\u0441\u043a\u0430\u044f \u043e\u0431\u043b\u0430\u0441\u0442\u044c)|\u042e\u0436\u043d\u044b\u0439]]\u00a0\u2014 \u043f\u0433\u0442 \u0441 [[1959 \u0433\u043e\u0434]]\u0430. \u0423\u043f\u0440\u0430\u0437\u0434\u043d\u0451\u043d \u0432 [[1979 \u0433\u043e\u0434]]\u0443.\n\n== \u041f\u0440\u0438\u043c\u0435\u0447\u0430\u043d\u0438\u044f ==\n{{\u041f\u0440\u0438\u043c\u0435\u0447\u0430\u043d\u0438\u044f}}\n\n== \u0421\u043c. \u0442\u0430\u043a\u0436\u0435 ==\n[[\u0411\u044b\u0432\u0448\u0438\u0435 \u043f\u043e\u0441\u0451\u043b\u043a\u0438 \u0433\u043e\u0440\u043e\u0434\u0441\u043a\u043e\u0433\u043e \u0442\u0438\u043f\u0430 \u0420\u043e\u0441\u0441\u0438\u0438]]\n\n[[\u041a\u0430\u0442\u0435\u0433\u043e\u0440\u0438\u044f:\u0411\u044b\u0432\u0448\u0438\u0435 \u043f\u043e\u0441\u0451\u043b\u043a\u0438 \u0433\u043e\u0440\u043e\u0434\u0441\u043a\u043e\u0433\u043e \u0442\u0438\u043f\u0430 \u041d\u0438\u0436\u0435\u0433\u043e\u0440\u043e\u0434\u0441\u043a\u043e\u0439 \u043e\u0431\u043b\u0430\u0441\u0442\u0438|*]]\n[[\u041a\u0430\u0442\u0435\u0433\u043e\u0440\u0438\u044f:\u0421\u043f\u0438\u0441\u043a\u0438 \u043d\u0430\u0441\u0435\u043b\u0451\u043d\u043d\u044b\u0445 \u043f\u0443\u043d\u043a\u0442\u043e\u0432 \u041d\u0438\u0436\u0435\u0433\u043e\u0440\u043e\u0434\u0441\u043a\u043e\u0439 \u043e\u0431\u043b\u0430\u0441\u0442\u0438]]"}}}]}}}}