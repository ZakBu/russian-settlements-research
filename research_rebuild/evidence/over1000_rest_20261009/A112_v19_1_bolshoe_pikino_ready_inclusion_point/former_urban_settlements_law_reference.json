0\u0441\u0442\u0438|access-date=2011-10-16|archive-date=2012-03-28|archive-url=https://www.webcitation.org/66Vc66sFi?url=http://zakon.scli.ru/ru/legal_texts/all/extended/index.php?d_id4=d2a1aa37-c589-4129-9e94-ad511eb26e83|url-status=live}}</ref>.\n* [[\u041a\u043d\u044f\u0433\u0438\u043d\u0438\u043d\u043e]]\u00a0\u2014 \u043f\u0433\u0442 \u0441 [[1968 \u0433\u043e\u0434]]\u0430. \u041f\u0440\u0435\u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d \u0432 \u0433\u043e\u0440\u043e\u0434 \u0432 [[1998 \u0433\u043e\u0434]]\u0443.\n* [[\u041a\u0440\u0430\u0441\u043d\u0430\u044f \u0413\u043e\u0440\u043a\u0430 (\u0412\u043e\u043b\u043e\u0434\u0430\u0440\u0441\u043a\u0438\u0439 \u0440\u0430\u0439\u043e\u043d)|\u041a\u0440\u0430\u0441\u043d\u0430\u044f \u0413\u043e\u0440\u043a\u0430]]\u00a0\u2014 \u043f\u0433\u0442 \u0441 1942 \u0433\u043e\u0434\u0430. \u041f\u0440\u0435\u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d \u0432 \u0441\u0435\u043b\u044c\u0441\u043a\u0438\u0439 \u043d\u0430\u0441\u0435\u043b\u0451\u043d\u043d\u044b\u0439 \u043f\u0443\u043d\u043a\u0442 \u0432 2013 \u0433\u043e\u0434\u0443.\n* [[\u041a\u0441\u0442\u043e\u0432\u043e]]\u00a0\u2014 \u043f\u0433\u0442 \u0441 [[1954 \u0433\u043e\u0434]]\u0430. \u041f\u0440\u0435\u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d \u0432 \u0433\u043e\u0440\u043e\u0434 \u0432 [[1957 \u0433\u043e\u0434]]\u0443.\n* [[\u041a\u0443\u043b\u0435\u0431\u0430\u043a\u0438]]\u00a0\u2014 \u043f\u0433\u0442 \u0441 1927 \u0433\u043e\u0434\u0430. \u041f\u0440\u0435\u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d \u0432 \u0433\u043e\u0440\u043e\u0434 \u0432 [[1932 \u0433\u043e\u0434]]\u0443.\n\n== \u041b ==\n* [[\u041b\u0435\u043d\u0438\u043d\u0441\u043a\u0430\u044f \u0421\u043b\u043e\u0431\u043e\u0434\u0430 (\u043f\u043e\u0441\u0451\u043b\u043e\u043a)|\u041b\u0435\u043d\u0438\u043d\u0441\u043a\u0430\u044f \u0421\u043b\u043e\u0431\u043e\u0434\u0430]]\u00a0\u2014 \u043f\u0433\u0442 \u0441 [[1936 \u0433\u043e\u0434]]\u0430. \u041f\u0440\u0435\u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d \u0432 \u0441\u0435\u043b\u044c\u0441\u043a\u0438\u0439 \u043d\u0430\u0441\u0435\u043b\u0451\u043d\u043d\u044b\u0439 \u043f\u0443\u043d\u043a\u0442 \u0432 [[2008 \u0433\u043e\u0434]]\u0443<ref>{{cite web|url=http://zakon.scli.ru/ru/legal_texts/all/extended/index.php?do4=document&id4=8548fd98-f1b8-4fad-a279-f6a1ee051bd6|title=\u0417\u0430\u043e\u043a\u043d \u041d\u0438\u0436\u0435\u0433\u043e\u0440\u043e\u0434\u0441\u043a\u043e\u0439 \u043e\u0431\u043b\u0430\u0441\u0442\u0438 \u2116 136-\u0417|date=2008-10-06|publisher=\u041f\u043e\u0440\u0442\u0430\u043b [[\u041c\u0438\u043d\u0438\u0441\u0442\u0435\u0440\u0441\u0442\u0432\u043e \u044e\u0441\u0442\u0438\u0446\u0438\u0438 \u0420\u0424|\u041c\u0438\u043d\u044e\u0441\u0442\u0430 \u0420\u0424]]|access-date=2011-10-16|url-status=dead}}</ref>.\n* [[\u041b\u0438\u043f\u043d\u044f (\u041d\u0430\u0432\u0430\u0448\u0438\u043d\u043e)|\u041b\u0438\u043f\u043d\u044f]]\u00a0\u2014 \u043f\u0433\u0442 \u0441 [[1945 \u0433\u043e\u0434]]\u0430. \u0412\u043e\u0448\u0451\u043b \u0432 \u0441\u043e\u0441\u0442\u0430\u0432 \u0433\u043e\u0440\u043e\u0434\u0430 [[\u041d\u0430\u0432\u0430\u0448\u0438\u043d\u043e]] \u0432 [[1957 \u0433\u043e\u0434]]\u0443.\n\n== \u041c ==\n* [[\u041c\u0430\u043a\u0430\u0440\u044c\u0435\u0432\u043e]]\u00a0\u2014 \u043f\u0433\u0442 \u0441 1958 \u0433\u043e\u0434\u0430. \u041f\u0440\u0435\u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d \u0432 \u0441\u0435\u043b\u044c\u0441\u043a\u0438\u0439 \u043d\u0430\u0441\u0435\u043b\u0451\u043d\u043d\u044b\u0439 \u043f\u0443\u043d\u043a\u0442 \u0432 [[2009 \u0433\u043e\u0434]]\u0443<ref>{{cite web|url=http://zakon.scli.ru/ru/legal_texts/all/extended/index.php?do4=document&id4=a7ddc1fb-330b-4353-aae7-81d998971a85|title=\u0417\u0430\u043a\u043e\u043d \u041d\u0438\u0436\u0435\u0433\u043e\u0440\u043e\u0434\u0441\u043a\u043e\u0439 \u043e\u0431\u043b\u0430\u0441\u0442\u0438 \u2116 121-\u0417|date=2009-08-11|publisher=\u041f\u043e\u0440\u0442\u0430\u043b [[\u041c\u0438\u043d\u0438\u0441\u0442\u0435\u0440\u0441\u0442\u0432\u043e \u044e\u0441\u0442\u0438\u0446\u0438\u0438 \u0420\u0424|\u041c\u0438\u043d\u044e\u0441\u0442\u0430 \u0420\u0424]]|access-date=2011-10-16|url-status=dead}}</ref>.\n* [[\u041c\u043e\u0440\u0434\u043e\u0432\u0449\u0438\u043a\u043e\u0432\u043e]]\u00a0\u2014 \u043f\u0433\u0442 \u0441 [[1928 \u0433\u043e\u0434]]\u0430. \u0412\u043e\u0448\u0451\u043b \u0432 \u0441\u043e\u0441\u0442\u0430\u0432 \u0433\u043e\u0440\u043e\u0434\u0430 \u041d\u0430\u0432\u0430\u0448\u0438\u043d\u043e \u0432 [[1957 \u0433\u043e\u0434]]\u0443.\n\n== \u041d ==\n* [[\u041d\u0435\u043a\u043b\u044e\u0434\u043e\u0432\u043e (\u041d\u0438\u0436\u0435\u0433\u043e\u0440\u043e\u0434\u0441\u043a\u0430\u044f \u043e\u0431\u043b\u0430\u0441\u0442\u044c)|\u041d\u0435\u043a\u043b\u044e\u0434\u043e\u0432\u043e]]\u00a0\u2014 \u043f\u0433\u0442 \u0441 [[1947 \u0433\u043e\u0434]]\u0430. \u0412\u043e\u0448\u0451\u043b \u0432 \u0441\u043e\u0441\u0442\u0430\u0432 \u0433\u043e\u0440\u043e\u0434\u0430 \u0411\u043e\u0440 \u0432 [[2004 \u0433\u043e\u0434]]\u0443<ref name=nnov139 />.\n* [[\u041d\u043e\u0432\u0430\u044f \u0421\u043b\u043e\u0431\u043e\u0434\u043a\u0430 (\u041d\u0438\u0436\u0435\u0433\u043e\u0440\u043e\u0434\u0441\u043a\u0430\u044f \u043e\u0431\u043b\u0430\u0441\u0442\u044c)|\u041d\u043e\u0432\u0430\u044f \u0421\u043b\u043e\u0431\u043e\u0434\u043a\u0430]]\u00a0\u2014 \u043f\u0433\u0442 \u0441 [[1938 \u0433\u043e\u0434]]\u0430. \u0423\u043f\u0440\u0430\u0437\u0434\u043d\u0451\u043d \u0432 \u0441\u0432\u044f\u0437\u0438 \u0441 \u0437\u0430\u0442\u043e\u043f\u043b\u0435\u043d\u0438\u0435\u043c \u0432\u043e\u0434\u0430\u043c\u0438 [[\u0413\u043e\u0440\u044c\u043a\u043e\u0432\u0441\u043a\u043e\u0435 \u0432\u043e\u0434\u043e\u0445\u0440\u0430\u043d\u0438\u043b\u0438\u0449\u0435|\u0413\u043e\u0440\u044c\u043a\u043e\u0432\u0441\u043a\u043e\u0433\u043e \u0432\u043e\u0434\u043e\u0445\u0440\u0430\u043d\u0438\u043b\u0438\u0449\u0430]] \u0432 [[1955 \u0433\u043e\u0434]]\u0443.\n\n== \u041e ==\n* [[\u041e\u043a\u0442\u044f\u0431\u0440\u044c\u0441\u043a\u0438\u0439 (\u0411\u043e\u0440)|\u041e\u043a\u0442\u044f\u0431\u0440\u044c\u0441\u043a\u0438\u0439]]\u00a0\u2014 \u043f\u0433\u0442 \u0441 [[1938 \u0433\u043e\u0434]]\u0430. \u0414\u043e 1957 \u0433\u043e\u0434\u0430 \u043d\u043e\u0441\u0438\u043b \u043d\u0430\u0437\u0432\u0430\u043d\u0438\u0435 '''\u0438\u043c\u0435\u043d\u0438 \u041c\u043e\u043b\u043e\u0442\u043e\u0432\u0430'''. \u0412\u043e\u0448\u0451\u043b \u0432 \u0441\u043e\u0441\u0442\u0430\u0432 \u0433\u043e\u0440\u043e\u0434\u0430 \u0411\u043e\u0440 \u0432 [[2004 \u0433\u043e\u0434]]\u0443<ref name=nnov139 />.\n\n== \u041f ==\n* [[\u041f\u0430\u043c\u044f\u0442\u044c \u041f\u0430\u0440\u0438\u0436\u0441\u043a\u043e\u0439 \u043a\u043e\u043c\u043c\u0443\u043d\u044b]]\u00a0\u2014 \u043f\u0433\u0442 \u0441 [[1932 \u0433\u043e\u0434]]\u0430. \u041f\u0440\u0435\u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d \u0432 \u0441\u0435\u043b\u044c\u0441\u043a\u0438\u0439 \u043d\u0430\u0441\u0435\u043b\u0451\u043d\u043d\u044b\u0439 \u043f\u0443\u043d\u043a\u0442 \u0432 [[2004 \u0433\u043e\u0434]]\u0443<ref name=\"nnov141\" />.\n* [[\u041f\u0435\u0440\u0435\u0432\u043e\u0437 (\u0433\u043e\u0440\u043e\u0434)|\u041f\u0435\u0440\u0435\u0432\u043e\u0437]]\u00a0\u2014 \u043f\u0433\u0442 \u0441 [[1962 \u0433\u043e\u0434]]\u0430. \u041f\u0440\u0435\u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d \u0432 \u0433\u043e\u0440\u043e\u0434 \u0432 [[2001 \u0433\u043e\u0434]]\u0443<ref>{{cite web|url=http://zakon.scli.ru/ru/legal_texts/all/extended/index.php?do4=document&id4=85df6c39-227f-484e-9f05-ed7f7a682abd|title=\u0417\u0430\u043a\u043e\u043d \u041d\u0438\u0436\u0435\u0433\u043e\u0440\u043e\u0434\u0441\u043a\u043e\u0439 \u043e\u0431\u043b\u0430\u0441\u0442\u0438 \u2116 159-\u0417|date=2001-01-15|publisher=\u041f\u043e\u0440\u0442\u0430\u043b [[\u041c\u0438\u043d\