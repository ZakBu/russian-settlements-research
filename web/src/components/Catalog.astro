---
import {MagnifyingGlass} from '@phosphor-icons/react';
import {materials,materialPages,visuals,datasets,research,materialPath,basePath,formatDate,evidenceLabel,currencyLabel} from '../lib/content';
import {tags,tagLabels,kindLabels,formatLabels,territoryLabels,getMaterialTags,getMaterialFormats,getMaterialTerritories,getMaterialSearchText} from '../lib/materials';
import {renderDocument} from '../lib/document';
import {ancestorsOf,buildHierarchy,flattenHierarchy} from '../lib/hierarchy';
import {publicationVersion} from '../lib/publication-version';
import MaterialCard from './MaterialCard.astro';
import MaterialTree from './MaterialTree.astro';
interface Props {kind?:string;researchId?:string;initialView?:'list'|'cards';legacy?:boolean;heading?:boolean}
const {researchId='',initialView='list',legacy=false,heading=true}=Astro.props;
const items=[...materials].sort((a,b)=>Number(b.id==='population-base')-Number(a.id==='population-base'));
const treeOrder=new Map(flattenHierarchy(buildHierarchy(materials)).map((m,i)=>[m.id,i]));
const rows=items.map(m=>({id:m.id,parentId:m.parentId,treeOrder:treeOrder.get(m.id),ancestors:ancestorsOf(m.id,materials).map(p=>p.id),title:m.title.replace(/^Состояние и описание исследования: /,'Ход работы: '),summary:m.summary,kind:m.kind,researchId:m.researchId,url:materialPath(m),tags:getMaterialTags(m),formats:getMaterialFormats(m),territories:getMaterialTerritories(m),search:getMaterialSearchText(m),updatedAt:Date.parse(m.updatedAt),version:publicationVersion(m),datasets:datasets.filter(d=>m.datasetIds.includes(d.id)).map(d=>({title:d.title,url:d.url}))}));
const ids=new Set(items.map(m=>m.id));
const edges=items.flatMap(m=>{
 const links=renderDocument(m.body,{basePath:basePath(),materialIds:materialPages.map(m=>m.id),visualIds:m.visualIds}).links.filter(id=>ids.has(id));
 return [...(m.parentId&&ids.has(m.parentId)?[{source:m.parentId,target:m.id,type:'hierarchy',label:'Содержит раздел'}]:[]),...links.map(target=>({source:m.id,target,type:'reference',label:'Ссылается на'})),...(m.supersedes&&ids.has(m.supersedes)?[{source:m.id,target:m.supersedes,type:'supersedes',label:'Уточняет предыдущую публикацию'}]:[])];
});
const data={rows,edges,base:basePath(),researchId,initialView,legacy,research:research.map(r=>({id:r.id,title:r.title,description:r.description}))};
const startIds=['research-guide','population-base','map-reading-guide','model-and-observation'];
---
<div class="materials-catalog" data-materials-catalog>
{heading&&<header class="materials-heading"><p class="eyebrow">Библиотека исследований</p><h1>Материалы</h1><p>Выберите исследование. Внутри — разделы, статьи, карты и связи между ними.</p></header>}
<section class="collection-hub" data-collection-hub aria-label="Коллекции исследований">{[...research].sort((a,b)=>a.order-b.order).map((r,i)=><a class="collection-card" data-collection-open={r.id} data-collection-color={r.id} href={basePath(`materials/?research=${r.id}`)}><span class="eyebrow">0{i+1} / Коллекция</span><h2>{r.title}</h2><p>{r.description}</p><span class="collection-card-meta">{materials.filter(m=>m.researchId===r.id).length} материалов <span aria-hidden="true">→</span></span></a>)}</section>
<section class="collection-context" data-collection-context hidden><a href={basePath('materials/')} data-collections-home>← Все коллекции</a><h2 data-collection-title></h2><p data-collection-description></p></section>
<div class="materials-discovery"><label><input type="checkbox" data-materials-unread/> Только новые <span data-unread-count></span></label><button type="button" data-mark-visible>Отметить найденные просмотренными</button></div>
<form class="materials-controls" role="search" aria-label="Поиск по материалам" action={basePath('materials/')}>
<label class="materials-search" for="materials-search"><span class="visually-hidden">Поиск материалов</span><MagnifyingGlass size={21} aria-hidden="true"/><input id="materials-search" name="q" type="search" placeholder="Найти по всем материалам…" aria-controls="materials-results"/><kbd aria-hidden="true">/</kbd></label>
<div class="materials-filter-row toolbar"><label>Тип<select name="kind" aria-label="Тип материала"><option value="">Все типы</option>{Object.entries(kindLabels).map(([key,label])=><option value={key}>{label}</option>)}</select></label><details class="materials-tag-filter"><summary>Темы <span data-tag-count></span></summary><fieldset><legend class="visually-hidden">Темы материалов</legend>{tags.map(tag=><label><input type="checkbox" name="tag" value={tag.id}/>{tag.label}</label>)}</fieldset></details><label>Формат<select name="format" aria-label="Формат материала"><option value="">Все форматы</option>{Object.entries(formatLabels).map(([id,label])=><option value={id}>{label}</option>)}</select></label><details class="materials-more"><summary>Ещё фильтры</summary><div><label>Территория<select name="territory" aria-label="Территория материала"><option value="">Все территории</option>{Object.entries(territoryLabels).map(([id,label])=><option value={id}>{label}</option>)}</select></label><label>Актуальность<select name="currency" aria-label="Актуальность материала"><option value="">Любая</option>{Object.entries(currencyLabel).map(([id,label])=><option value={id}>{label}</option>)}</select></label></div></details></div><noscript><button class="secondary-button" type="submit">Искать</button><p>Все документы доступны ниже. Для фильтрации включите JavaScript или используйте поиск браузера.</p></noscript>
</form>
<div class="materials-active-filters" data-active-filters role="group" aria-label="Выбранные условия"></div>
<div class="materials-view-bar"><p role="status" data-material-count>{items.length} материалов</p><div class="materials-views" role="group" aria-label="Представление материалов"><button type="button" data-view="tree" aria-pressed="false">Структура</button><button type="button" data-view="list" aria-pressed={initialView==='list'}>Список</button><button type="button" data-view="cards" aria-pressed={initialView==='cards'}>Карточки</button><button type="button" data-view="graph" aria-pressed="false">Связи</button></div><label class="materials-sort">Порядок<select name="sort" aria-label="Сортировка материалов"><option value="updated">Сначала обновлённые</option><option value="tree">По структуре разделов</option><option value="title">По названию</option><option value="relevance">По релевантности</option></select></label></div>
<p class="materials-collection" data-collection-note hidden>С чего начать: вводные материалы и основные результаты исследования.</p>
<div id="materials-results">
<section data-materials-tree aria-label="Структура коллекций" hidden>{research.map(r=><section data-collection-tree={r.id} data-collection-color={r.id}><h2>{r.title}</h2><MaterialTree nodes={buildHierarchy(materials.filter(m=>m.researchId===r.id))}/></section>)}</section>
<div class="materials-list" data-materials-list hidden={initialView!=='list'}>{items.map(m=><article class="library-entry" data-material-list={m.id} data-material-id={m.id} data-version={publicationVersion(m)}><div><p class="eyebrow">{kindLabels[m.kind]} / {research.find(r=>r.id===m.researchId)?.title}</p><h2><span class="unread-dot" data-unread-dot hidden role="img" aria-label="Новый материал"></span><a href={materialPath(m)} data-material-link>{m.title.replace(/^Состояние и описание исследования: /,'Ход работы: ')}</a></h2><p>{m.summary}</p>{m.parentId&&<p class="materials-page-path">{ancestorsOf(m.id,materials).map(parent=><a href={materialPath(parent)}>{parent.title}</a>)}</p>}<div class="materials-tags">{getMaterialTags(m).slice(0,3).map(id=><a href={basePath(`materials/?tag=${id}`)} data-tag-link={id}>{tagLabels[id]}</a>)}</div><div class="library-entry-meta"><span>{getMaterialFormats(m).map(f=>formatLabels[f]).join(' · ')||'Текст'}</span><span>{evidenceLabel[m.evidence]}</span><span class:list={{'materials-warning':m.currency!=='current'}}>{currencyLabel[m.currency]}</span><time datetime={m.updatedAt}>{formatDate(m.updatedAt)}</time></div></div></article>)}</div>
<div class="editorial-grid" data-catalog data-materials-cards hidden={initialView!=='cards'}>{items.map((m,i)=><MaterialCard material={m} index={i} featured={i===0}/>)}</div>
<section class="materials-graph" aria-label="Связи материалов" data-materials-graph hidden><p>Выберите документ в схеме или списке, чтобы увидеть, с чем он связан. Цвет — коллекция. Толстая линия — вложенность разделов, тонкая — ссылка в тексте, пунктирная — уточнение публикации.</p><div class="materials-graph-controls"><label>Окружение документа<select data-graph-focus aria-label="Документ для локального графа"><option value="">Все найденные материалы</option></select></label><label>Глубина<select data-graph-depth aria-label="Глубина связей"><option value="1">Один шаг</option><option value="2">Два шага</option></select></label></div><div data-graph-canvas role="img" aria-label="Граф связей документов; текстовый список расположен ниже"></div><p role="status" data-graph-status></p><div data-graph-preview hidden></div><details open><summary>Документы и связи текстом</summary><ul data-graph-links></ul></details></section>
</div><div class="empty-state" data-materials-empty hidden><p>Материалов по этим условиям не найдено. Попробуйте убрать тему или расширить поиск.</p><button type="button" class="secondary-button" data-catalog-reset>Сбросить поиск и фильтры</button></div>
</div>
<script is:inline type="application/json" id="materials-data" set:html={JSON.stringify({...data,startIds,currency:Object.fromEntries(items.map(m=>[m.id,m.currency]))}).replace(/</g,'\\u003c')}/>
<script src="../lib/materials-client.ts"/>
