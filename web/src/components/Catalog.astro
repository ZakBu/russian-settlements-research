---
import {MagnifyingGlass, ArrowRight} from '@phosphor-icons/react';
import {materials,basePath} from '../lib/content';
import MaterialCard from './MaterialCard.astro';
interface Props {kind:'atlas'|'knowledge';researchId?:string}
const {kind,researchId}=Astro.props;
const items=materials.filter(m=>(kind==='atlas'?['finding','correction'].includes(m.kind):['method','note'].includes(m.kind))&&(!researchId||m.researchId===researchId)).sort((a,b)=>Number(b.id==='population-base')-Number(a.id==='population-base'));
const unique=(key:'topic'|'territory'|'period')=>[...new Set(items.map(m=>m[key]))];
---
<div class="toolbar" data-catalog-controls><select aria-label="Тема" data-filter="topic"><option value="">Все темы</option>{unique('topic').map(t=><option>{t}</option>)}</select><select aria-label="Территория" data-filter="territory"><option value="">Территория</option>{unique('territory').map(t=><option>{t}</option>)}</select><select aria-label="Период" data-filter="period"><option value="">Период</option>{unique('period').map(t=><option>{t}</option>)}</select><div class="search-field"><MagnifyingGlass size={18}/><input type="search" placeholder={kind==='atlas'?'Поиск по материалам атласа':'Поиск по знаниям'} aria-label="Поиск материалов" data-search-input/></div><span class="result-count" aria-live="polite"><span data-result-count>{items.length}</span> материалов</span></div>
<div class="editorial-grid" data-catalog>{items.map((m,i)=><MaterialCard material={m} index={i} featured={i===0}/>)}</div><div class="empty-state" data-empty hidden={items.length>0}>Материалов по выбранным условиям пока нет.<br/><button class="secondary-button" data-reset-filters>Сбросить фильтры</button></div>
<script>
const controls=document.querySelector('[data-catalog-controls]');
if(controls){
 let selectedResearch=new URLSearchParams(location.search).get('research')||'';
 const update=()=>{
  const q=(controls.querySelector('[data-search-input]') as HTMLInputElement).value.toLocaleLowerCase('ru').trim();
  const filters=[...controls.querySelectorAll<HTMLSelectElement>('[data-filter]')];let count=0;
  document.querySelectorAll<HTMLElement>('[data-material-card]').forEach(card=>{
   const visible=(!selectedResearch||card.dataset.research===selectedResearch)&&(!q||(card.dataset.search||'').includes(q))&&filters.every(f=>!f.value||card.dataset[f.dataset.filter!]===f.value);
   card.hidden=!visible;if(visible)count++;
  });
  document.querySelector('[data-result-count]')!.textContent=String(count);
  (document.querySelector('[data-empty]') as HTMLElement).hidden=count>0;
 };
 controls.addEventListener('input',update);controls.addEventListener('change',update);
 document.querySelector('[data-reset-filters]')?.addEventListener('click',()=>{
  controls.querySelectorAll<HTMLInputElement|HTMLSelectElement>('input,select').forEach(e=>e.value='');selectedResearch='';
  const url=new URL(location.href);url.searchParams.delete('research');history.replaceState(null,'',url);window.dispatchEvent(new Event('atlas-research-reset'));update();
 });
 update();
}
</script>
