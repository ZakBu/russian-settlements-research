---
import '../styles/documents.css';
import {ArrowUpRight} from '@phosphor-icons/react';
import {research,materials,basePath} from '../lib/content';
import MaterialTree from './MaterialTree.astro';
import {buildHierarchy} from '../lib/hierarchy';
interface Props {current?:string;researchId?:string}
const {researchId='',current=''}=Astro.props;
---
<nav class="document-library" aria-label="Навигация материалов"><details class="document-library-menu" open><summary>Материалы и исследования <span aria-hidden="true">⌄</span></summary><div class="document-library-body"><a class="library-home" href={basePath('materials/')} data-catalog-preset="all">Все материалы <ArrowUpRight size={14} aria-hidden="true"/></a><section><h2>Библиотека</h2><ul><li><a href={basePath('materials/?collection=start')} data-catalog-preset="start">С чего начать</a></li><li><a href={basePath('materials/research-guide/')}>Путеводитель по исследованию</a></li><li><a href={basePath('updates/?unread=1')}>Непросмотренные обновления</a></li></ul></section><section><h2>Исследования</h2><ul>{[...research].sort((a,b)=>a.order-b.order).map(r=><li><a href={basePath(`materials/?research=${r.id}`)} data-catalog-research={r.id} aria-current={researchId===r.id?'page':undefined}>{r.title}</a></li>)}</ul></section><section><h2>Подборки</h2><ul><li><a href={basePath('materials/?kind=method')} data-catalog-preset="method">Методы и понятия</a></li><li><a href={basePath('materials/?tag=data-quality')} data-catalog-preset="quality">Качество данных</a></li></ul></section><section class="library-page-structure"><h2>Страницы исследований</h2>{[...research].sort((a,b)=>a.order-b.order).map(r=><details class="library-research-tree" data-research-tree={r.id} open={researchId===r.id}><summary>{r.title}</summary><MaterialTree nodes={buildHierarchy(materials.filter(m=>m.researchId===r.id))} current={current}/></details>)}</section></div></details></nav>
