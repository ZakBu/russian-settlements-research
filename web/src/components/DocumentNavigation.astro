---
import '../styles/documents.css';
import {ArrowUpRight} from '@phosphor-icons/react';
import {materials,research,materialPath,basePath} from '../lib/content';
interface Props {current?:string}
const {current=''}=Astro.props;
const groups=[...research].sort((a,b)=>a.order-b.order).map(r=>({...r,items:materials.filter(m=>m.researchId===r.id).sort((a,b)=>a.topic.localeCompare(b.topic,'ru')||a.title.localeCompare(b.title,'ru'))}));
---
<nav class="document-library" aria-label="Библиотека документов"><details class="document-library-menu" open><summary>Библиотека документов <span aria-hidden="true">⌄</span></summary><div class="document-library-body"><a class="library-home" href={basePath('knowledge/')}>Все документы <ArrowUpRight size={14} aria-hidden="true"/></a><a class="library-home" href={basePath("materials/research-guide/")} aria-current={current==='research-guide'?'page':undefined}>С чего начать: путеводитель <ArrowUpRight size={14} aria-hidden="true"/></a>{groups.filter(r=>r.items.length).map(r=><section><h2>{r.title}</h2><ul>{r.items.map(m=><li><a href={materialPath(m)} aria-current={m.id===current?'page':undefined}>{m.title.replace(/^Состояние и описание исследования: /,'Ход работы: ')}</a></li>)}</ul></section>)}</div></details></nav>
