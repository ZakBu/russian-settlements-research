---
import '../styles/documents.css';
import {ArrowUpRight} from '@phosphor-icons/react';
import {research,materials,basePath} from '../lib/content';
import MaterialTree from './MaterialTree.astro';
import {buildHierarchy} from '../lib/hierarchy';
interface Props {current?:string;researchId?:string;compact?:boolean}
const {researchId='',current='',compact=false}=Astro.props;
---
<nav class="document-library" aria-label="Навигация материалов"><details class="document-library-menu" open><summary>Коллекции исследований <span aria-hidden="true">⌄</span></summary><div class="document-library-body"><a class="library-home" href={basePath('materials/')} data-collections-home>Все коллекции <ArrowUpRight size={14} aria-hidden="true"/></a><section><h2>Исследования</h2><ul>{[...research].sort((a,b)=>a.order-b.order).map(r=><li><a href={basePath(`materials/?research=${r.id}`)} data-catalog-research={r.id} aria-current={researchId===r.id?'page':undefined}><i class="collection-key" data-collection-color={r.id} aria-hidden="true"/>{r.title}</a></li>)}</ul></section><section><a href={basePath('materials/?unread=1')}>Новые материалы</a></section>{!compact&&<section class="library-page-structure"><h2>Разделы коллекций</h2>{[...research].sort((a,b)=>a.order-b.order).map(r=><details class="library-research-tree" data-research-tree={r.id} open={researchId===r.id}><summary>{r.title}</summary><MaterialTree nodes={buildHierarchy(materials.filter(m=>m.researchId===r.id))} current={current}/></details>)}</section>}</div></details></nav>
