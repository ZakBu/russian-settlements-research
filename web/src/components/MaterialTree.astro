---
import {basePath,materialPath,type Material} from '../lib/content';
import type {HierarchyNode} from '../lib/hierarchy';
interface Props {nodes:HierarchyNode<Material>[];current?:string}
const {nodes,current=''}=Astro.props;
const contains=(node:HierarchyNode<Material>):boolean=>node.page.id===current||node.children.some(contains);
---
<ul class="material-page-tree">{nodes.map(node=><li data-page-tree-node={node.page.id}>{node.children.length?<details data-page-tree-branch={node.page.id} open={contains(node)}><summary>{node.page.title.replace(/^Состояние и описание исследования: /,'Ход работы: ')}</summary><div class="tree-section-actions"><a href={materialPath(node.page)} aria-label={`Открыть страницу: ${node.page.title}`} aria-current={node.page.id===current?'page':undefined}>Открыть страницу</a><a href={basePath(`materials/?within=${node.page.id}`)} aria-label={`Весь раздел: ${node.page.title}`}>Весь раздел</a></div><Astro.self nodes={node.children} current={current}/></details>:<a href={materialPath(node.page)} aria-current={node.page.id===current?'page':undefined}>{node.page.title.replace(/^Состояние и описание исследования: /,'Ход работы: ')}</a>}</li>)}</ul>
