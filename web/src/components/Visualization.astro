---
import type {Visual} from '../lib/content';
import type {FigureInfo} from '../lib/bibliography';
import {datasets,basePath,mapPreviewVariant} from '../lib/content';
import VisualChart from './VisualChart';
import MapThumbnail from './MapThumbnail.astro';
interface Props {visual:Visual;exportMode?:boolean;publication?:FigureInfo}
const {visual:v,exportMode=false,publication:p}=Astro.props;
const isLinks=v.template==='service-links';const isMap=['settlement-map','service-links'].includes(v.template);const dataset=datasets.find(d=>d.id===v.datasetId);
const params=new URLSearchParams();if(v.mapState)for(const [k,value]of Object.entries(v.mapState))params.set(k,Array.isArray(value)?value.join(','):String(value));
---
<figure class="figure" data-visual-id={v.id} data-figure-kind={p?.kind} data-figure-number={p?.number} data-figure-title={v.title}>
<div class="figure-toolbar" style="display:flex;gap:20px;align-items:baseline;justify-content:space-between;flex-wrap:wrap">{!p&&<h2>{v.title}</h2>}{isMap&&<a class="secondary-button" href={basePath(`map/?${params}`)}>Исследовать на карте →</a>}</div>
{p?.kind==='table'&&<p class="document-figure-caption">{p.label}</p>}
<div class="figure-graphic" data-figure-graphic>
{isLinks?<div class="link-preview"><p>Связи показаны на интерактивной карте с отдельными основаниями, источниками и датами.</p><a class="primary-button" href={basePath(`map/?${params}`)}>Открыть локальные связи →</a></div>:isMap?<div><MapThumbnail base={basePath()} caption={v.title} variant={mapPreviewVariant(v)} large/></div>:v.template==='table'?<div style="overflow:auto"><table class="data-table"><tbody>{v.data?.map((row:any)=><tr>{Object.values(row).map(cell=><td>{String(cell??'Нет сведений')}</td>)}</tr>)}</tbody></table></div>:<VisualChart visual={v} client:load/>}
</div>
<figcaption><p class="figure-explanation">{v.caption} {v.unit&&<span>Единица: {v.unit}.</span>}</p>{p?<>{p.kind!=='table'&&<p class="document-figure-caption">{p.label}</p>}<p class="document-figure-source">Источник: {p.authored?'построено автором по данным':'данные'} {p.sourceTitle} {p.sourceNumber&&<a class="document-citation" data-citation-url={p.sourceUrl} href={`#${p.sourceId}`}>[{p.sourceNumber}]</a>}</p></>:dataset&&<a href={dataset.url} target="_blank" rel="noopener noreferrer">Источник: {dataset.title} ↗</a>}</figcaption>
{v.limitations?.length&&<p class="figure-limitations" style="font-size:12px;color:var(--muted)">{v.limitations.join(' ')}</p>}
{v.series?.length&&<details class="figure-data"><summary>Данные графика в таблице</summary><div style="overflow:auto"><table class="data-table"><thead><tr><th>Показатель</th>{v.categories?.map(c=><th>{c}</th>)}</tr></thead><tbody>{v.series.map(s=><tr><th>{s.name}</th>{s.values.map(value=><td>{value===null?'Нет сведений':value.toLocaleString('ru-RU')}</td>)}</tr>)}</tbody></table></div></details>}
</figure>
