---
import {ArrowUpRight,ArrowLeft} from '@phosphor-icons/react';
import Layout from '../../layouts/Layout.astro';
import Visualization from '../../components/Visualization.astro';
import DocumentNavigation from '../../components/DocumentNavigation.astro';
import {materials,materialPages,visuals,datasets,research,basePath,materialPath,formatDate,currencyLabel,evidenceLabel} from '../../lib/content';
import {renderDocument} from '../../lib/document';
export function getStaticPaths(){return materialPages.map(m=>({params:{id:m.id},props:{material:m}}))}
const {material:m}=Astro.props;
const itemVisuals=m.visualIds.map((id:string)=>visuals.find(v=>v.id===id)).filter(Boolean);
const itemDatasets=datasets.filter(d=>m.datasetIds.includes(d.id));const project=research.find(r=>r.id===m.researchId);
// The lead already presents this paragraph; retain the stored scientific text unchanged.
const paragraphs=m.body.trim().split(/\n\s*\n/);const bodySource=paragraphs[0]?.trim()===m.summary.trim()?paragraphs.slice(1).join('\n\n'):m.body;
const options={basePath:basePath(),materialIds:materialPages.map(x=>x.id),visualIds:m.visualIds};
const doc=renderDocument(bodySource,options);
const remainingVisuals=itemVisuals.filter((v:any)=>!doc.visualIds.includes(v.id));
const toc=doc.blocks.flatMap(block=>block.type==='visual'?[{id:`visual-${block.id}`,text:visuals.find(v=>v.id===block.id)?.title||block.id,depth:2}]:doc.headings.filter(h=>block.html.includes(`id="${h.id}"`)));
toc.push(...remainingVisuals.map((v:any)=>({id:`visual-${v.id}`,text:v.title,depth:2})),{id:'document-sources',text:'Источники и версия',depth:2});
const backlinks=materials.filter(other=>other.id!==m.id&&renderDocument(other.body,{...options,visualIds:other.visualIds}).links.includes(m.id));
const related=materials.filter(other=>other.id!==m.id&&(doc.links.includes(other.id)||(other.researchId===m.researchId&&other.kind==='method'))).slice(0,4);
const readTime=Math.max(1,Math.ceil(m.body.trim().split(/\s+/).length/180));
---
<Layout title={m.title} active={['method','note'].includes(m.kind)?'knowledge':'atlas'} researchId={m.researchId} description={m.summary}><div class="document-shell"><DocumentNavigation current={m.id}/><div class="document-main">
<header class="document-header"><nav class="document-breadcrumbs" aria-label="Путь документа"><a href={basePath('knowledge/')}>Библиотека</a><span aria-hidden="true">/</span><a href={basePath(`research/${m.researchId}/`)}>{project?.title||m.researchId}</a></nav><p class="eyebrow">{m.topic}</p><h1>{m.title.replace(/^Состояние и описание исследования: /,'Ход исследования: ')}</h1><p class="document-lead">{m.summary}</p><div class="document-meta"><span>{evidenceLabel[m.evidence]||m.evidence}</span><span>{readTime} мин чтения</span><time datetime={m.updatedAt}>Обновлено {formatDate(m.updatedAt)}</time></div><div class="document-context"><span>{m.territory}</span><span>{m.period}</span></div>{(m.currency!=='current'||m.visibility==='archived')&&<div class="warning-banner">{m.visibility==='archived'?'Архивная публикация':currencyLabel[m.currency]}. Учитывайте ограничения описанной версии.{m.supersedes&&<span> Предыдущий материал: <a href={basePath(`materials/${m.supersedes}/`)}>открыть</a>.</span>}</div>}</header>
<details class="document-mobile-toc"><summary>На этой странице <span aria-hidden="true">⌄</span></summary><nav aria-label="Оглавление на телефоне">{toc.map(h=><a href={`#${h.id}`} class:list={{'toc-subsection':h.depth===3}}>{h.text}</a>)}</nav></details>
<article class="article-body document-body" aria-label="Текст документа">{doc.blocks.map(block=>block.type==='markdown'?<div class="document-prose" set:html={block.html}/>:<section id={`visual-${block.id}`} class="document-visual"><Visualization visual={visuals.find(v=>v.id===block.id)!}/></section>)}{remainingVisuals.map((v:any)=><section id={`visual-${v.id}`} class="document-visual"><Visualization visual={v}/></section>)}</article>
<section class="document-sources" id="document-sources" aria-labelledby="document-sources-title"><p class="eyebrow">Происхождение / актуальность</p><h2 id="document-sources-title">Источники и версия</h2><ol>{m.sources.map((s:{title:string;url:string})=><li><a href={s.url} target="_blank" rel="noopener noreferrer">{s.title}<ArrowUpRight size={12} aria-hidden="true"/></a></li>)}</ol>{itemDatasets.length>0&&<details><summary>Наборы данных и ограничения <span class="mono">{itemDatasets.length}</span></summary>{itemDatasets.map(d=><div class="document-dataset"><h3><a href={d.url}>{d.title}<ArrowUpRight size={12} aria-hidden="true"/></a></h3><p class="mono">{d.release}</p><ul>{d.limitations.map(l=><li>{l}</li>)}</ul></div>)}</details>}<p class="document-version">Исходный коммит: <a class="mono" href={`https://github.com/ZakBu/russian-settlements-research/commit/${m.sourceCommit}`}>{m.sourceCommit.slice(0,8)}</a> · <a href={`https://github.com/ZakBu/russian-settlements-research/blob/main/web/content/materials/${m.id}.json`}>История и исходный документ <ArrowUpRight size={12} aria-hidden="true"/></a></p></section>
{backlinks.length>0&&<section class="document-related"><h2>На этот документ ссылаются</h2><ul>{backlinks.map(other=><li><a href={materialPath(other)}>{other.title} <span aria-hidden="true">→</span></a></li>)}</ul></section>}{related.length>0&&<section class="document-related"><h2>Читайте также</h2><ul>{related.map(other=><li><a href={materialPath(other)}>{other.title} <span aria-hidden="true">→</span></a></li>)}</ul></section>}<a class="document-back" href={basePath('knowledge/')}><ArrowLeft size={14} aria-hidden="true"/> Все документы библиотеки</a></div>
<aside class="document-rail"><nav aria-label="На этой странице"><h2>На этой странице</h2>{toc.map(h=><a href={`#${h.id}`} data-toc-link class:list={{'toc-subsection':h.depth===3}}>{h.text}</a>)}</nav><div class="document-tools"><button type="button" data-copy-document>Скопировать ссылку</button><a href="#main">К началу ↑</a><span role="status" data-copy-status></span></div></aside></div></Layout>
<script src="../../lib/document-client.ts"/>
