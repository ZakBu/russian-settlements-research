---
import Layout from '../layouts/Layout.astro';
import Updates from '../components/Updates.astro';
import '../styles/materials.css';
import MapThumbnail from '../components/MapThumbnail.astro';
import VisualChart from '../components/VisualChart';
import {ArrowRight} from '@phosphor-icons/react';
import {materials,visuals,basePath,formatDate,materialPath} from '../lib/content';
const published=materials.filter(m=>m.visibility==='published');
const latest=published.slice(0,3);
---
<Layout title="Развитие исследования"><div class="shell"><section class="hero"><div class="hero-copy"><span class="eyebrow">01 / Живой атлас исследования</span><h1>География<br/><span>людей и связей</span></h1><p class="intro">Как меняется расселение России и что связывает населённые пункты.</p><p>Карты, графики и объяснения по результатам исследования. Новые результаты появляются здесь вместе с обновлениями репозитория.</p><div class="hero-actions"><a href={basePath('map/')} class="primary-button">Исследовать карту <ArrowRight size={19}/></a><a href={basePath('materials/?view=cards')} class="secondary-button">Открыть материалы <ArrowRight size={17}/></a></div></div><div class="hero-visual"><MapThumbnail base={basePath()} large hero variant="change" caption="География населённых пунктов по связанным переписям"/></div></section>
<div class="research-strip"><span>ПЕРЕПИСИ 2002 / 2010 / 2021</span><span>НАСЕЛЕНИЕ / УСЛУГИ / СВЯЗИ</span><span>{latest[0]?`ОБНОВЛЕНО ${formatDate(latest[0].updatedAt)}`:'Исследовательский портал'}</span></div>
<section class="topic-grid" aria-label="Направления исследования">
<article class="editorial-panel topic-card"><div class="panel-meta"><span>02 /</span><span>Население</span><a href={basePath('research/population/')} aria-label="Население и расселение">↗</a></div><div class="topic-card-body"><div><h2><a href={basePath('research/population/')}>Распределение<br/>и динамика</a></h2><p>Как меняется население городов, посёлков и сёл между переписями.</p><a class="panel-link" href={basePath('research/population/')}>2002 / 2010 / 2021 →</a></div><MapThumbnail base={basePath()} variant="change"/></div></article>
<article class="editorial-panel topic-card"><div class="panel-meta"><span>03 /</span><span>Услуги и доступность</span><a href={basePath('research/sgrt/')} aria-label="Районы тяготения">↗</a></div><div class="topic-card-body"><div><h2><a href={basePath('research/sgrt/')}>Ближе<br/><span class="keep-line">к возможностям</span></a></h2><p>Модельные центры, их окружение и проверка связей обслуживания.</p><a class="panel-link" href={basePath('research/sgrt/')}>Результаты СГРТ →</a></div><figure class="topic-figure"><VisualChart visual={visuals.find(v=>v.id==='centre-count-selection')!} compact client:visible/><figcaption>978 → 804 → 197 НП<br/>Как сужается отбор центров</figcaption></figure></div></article>
<article class="editorial-panel topic-card"><div class="panel-meta"><span>04 /</span><span>Центр и окружение</span><a href={basePath('research/ecommerce/')} aria-label="Маркетплейсы и центры">↗</a></div><div class="topic-card-body"><div><h2><a href={basePath('research/ecommerce/')}>Связи<br/>территорий</a></h2><p>Маркетплейсы и изменение концентрации населения в средних центрах.</p><a class="panel-link" href={basePath('research/ecommerce/')}>Исследовать →</a></div><figure class="topic-figure"><VisualChart visual={visuals.find(v=>v.id==='ecommerce-concentration')!} compact client:visible/><figcaption>435 — рост доли центра<br/>386 — из них с убылью обеих частей<br/>Из 564 центров · 2023–2025</figcaption></figure></div></article>
</section>
<Updates compact/>
</div></Layout>
