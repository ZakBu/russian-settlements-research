{
  "name": "research-atlas",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "astro dev --host 0.0.0.0 --port 4173",
    "build": "astro build && node scripts/build-word-exports.mjs",
    "preview": "astro preview --host 0.0.0.0 --port 4173",
    "test": "playwright test",
    "check": "tsc --noEmit && npm run test:unit",
    "prebuild": "node scripts/build-map-previews.mjs",
    "predev": "node scripts/build-map-previews.mjs",
    "test:unit": "node --test tests-unit/*.test.ts",
    "word": "node scripts/build-word-exports.mjs"
  },
  "dependencies": {
    "@astrojs/react": "^4.4.2",
    "@fontsource/golos-text": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/prata": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@tailwindcss/vite": "^4.1.0",
    "astro": "5.18.2",
    "d3-geo": "^3.1.1",
    "d3-selection": "^3.0.0",
    "d3-zoom": "^3.0.0",
    "echarts": "^6.0.0",
    "maplibre-gl": "^5.10.0",
    "marked": "^17.0.1",
    "marked-alert": "^2.1.2",
    "marked-footnote": "^1.4.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
